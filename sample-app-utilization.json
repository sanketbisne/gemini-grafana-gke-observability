    {
      "collapsed": false,
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 10,
      "title": "Nginx CPU Utilization %",
      "type": "gauge",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(container_cpu_usage_seconds_total{pod=~\"sample-app-.*\", container=\"web\"}[5m])) by (pod) / sum(container_spec_cpu_quota{pod=~\"sample-app-.*\", container=\"web\"} / container_spec_cpu_period{pod=~\"sample-app-.*\", container=\"web\"}) by (pod) * 100",
          "legendFormat": "{{pod}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 11,
      "title": "Nginx Memory Utilization %",
      "type": "gauge",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(container_memory_working_set_bytes{pod=~\"sample-app-.*\", container=\"web\"}) by (pod) / sum(container_spec_memory_limit_bytes{pod=~\"sample-app-.*\", container=\"web\"}) by (pod) * 100",
          "legendFormat": "{{pod}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 12,
      "title": "Nginx Pod Log Size",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(kubelet_container_log_filesystem_used_bytes{pod=~\"sample-app-.*\", container=\"web\"}) by (pod)",
          "legendFormat": "{{pod}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 13,
      "title": "Nginx Web CPU Usage vs Limit",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "rate(container_cpu_usage_seconds_total{pod=~\"sample-app-.*\", container=\"web\"}[5m])",
          "legendFormat": "{{pod}} CPU Usage",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "container_spec_cpu_quota{pod=~\"sample-app-.*\", container=\"web\"} / container_spec_cpu_period{pod=~\"sample-app-.*\", container=\"web\"}",
          "legendFormat": "{{pod}} CPU Limit",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineStyle": {
              "dash": [5, 5]
            }
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "id": 14,
      "title": "Nginx Web Memory Usage vs Limit",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "container_memory_working_set_bytes{pod=~\"sample-app-.*\", container=\"web\"}",
          "legendFormat": "{{pod}} Memory Usage",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "container_spec_memory_limit_bytes{pod=~\"sample-app-.*\", container=\"web\"}",
          "legendFormat": "{{pod}} Memory Limit",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "id": 15,
      "title": "Pod Container Log Filesystem Growth",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "kubelet_container_log_filesystem_used_bytes{pod=~\"sample-app-.*\", container!=\"\"}",
          "legendFormat": "{{pod}} - {{container}} log",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "id": 16,
      "title": "Underlying Node Disk/Filesystem Utilization %",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(container_fs_usage_bytes{id=\"/\"}) by (instance, device) / sum(container_fs_limit_bytes{id=\"/\"}) by (instance, device) * 100",
          "legendFormat": "{{instance}} - {{device}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    }
